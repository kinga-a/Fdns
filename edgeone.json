{
  "outputDirectory": "public",
  "buildCommand": "",
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html",
      "exclude": ["/api/*", "/api/**/*"]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    }
  ]
}
