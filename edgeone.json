{
  "outputDirectory": "public",
  "buildCommand": "",
  "rewrites": [
    {
      "source": "/api/*",
      "destination": "/api/*"
    },
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    }
  ]
}
